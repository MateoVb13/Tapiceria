<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.MainPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="TapizPro - Tapicería Automotriz">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="CenterAndExpand">

            <!-- Banner superior con sombra -->
            <Frame Style="{StaticResource CardStyle}" Padding="0" HeightRequest="200">
                <Grid>
                    <Image Source="materiales.jpg"
                           Aspect="AspectFill" />
                    <BoxView BackgroundColor="#80000000"/>
                    <VerticalStackLayout VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       Spacing="10" 
                                       Padding="20">
                        <Label Text="TapizPro" 
                               FontSize="36" 
                               TextColor="White" 
                               FontAttributes="Bold" 
                               HorizontalTextAlignment="Center"/>
                        <Label Text="La mejor tapicería automotriz" 
                               FontSize="18" 
                               TextColor="White" 
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Bienvenida -->
            <Label Text="¡Bienvenido a TapizPro!"
                   Style="{StaticResource TitleStyle}" />

            <!-- Servicios destacados como tarjetas -->
            <Label Text="Nuestros Servicios" 
                   Style="{StaticResource SubtitleStyle}" 
                   Margin="0,10,0,5"/>

            <Grid ColumnDefinitions="*,*" 
                  RowDefinitions="*,*" 
                  RowSpacing="15" 
                  ColumnSpacing="15">

                <!-- Servicio 1 -->
                <Frame Grid.Row="0" 
                       Grid.Column="0" 
                       Style="{StaticResource ServiceCardStyle}">
                    <VerticalStackLayout>
                        <Label Text="🔧" 
                               FontSize="30" 
                               HorizontalOptions="Center"/>
                        <Label Text="Restauración" 
                               FontSize="14" 
                               TextColor="{StaticResource TextPrimaryColor}" 
                               HorizontalTextAlignment="Center" 
                               FontAttributes="Bold" 
                               Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Servicio 2 -->
                <Frame Grid.Row="0" 
                       Grid.Column="1" 
                       Style="{StaticResource ServiceCardStyle}">
                    <VerticalStackLayout>
                        <Label Text="🪑" 
                               FontSize="30" 
                               HorizontalOptions="Center"/>
                        <Label Text="Tapizado" 
                               FontSize="14" 
                               TextColor="{StaticResource TextPrimaryColor}" 
                               HorizontalTextAlignment="Center" 
                               FontAttributes="Bold" 
                               Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Servicio 3 -->
                <Frame Grid.Row="1" 
                       Grid.Column="0" 
                       Style="{StaticResource ServiceCardStyle}">
                    <VerticalStackLayout>
                        <Label Text="✨" 
                               FontSize="30" 
                               HorizontalOptions="Center"/>
                        <Label Text="Personalización" 
                               FontSize="14" 
                               TextColor="{StaticResource TextPrimaryColor}" 
                               HorizontalTextAlignment="Center" 
                               FontAttributes="Bold" 
                               Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Servicio 4 -->
                <Frame Grid.Row="1" 
                       Grid.Column="1" 
                       Style="{StaticResource ServiceCardStyle}">
                    <VerticalStackLayout>
                        <Label Text="🧼" 
                               FontSize="30" 
                               HorizontalOptions="Center"/>
                        <Label Text="Limpieza" 
                               FontSize="14" 
                               TextColor="{StaticResource TextPrimaryColor}" 
                               HorizontalTextAlignment="Center" 
                               FontAttributes="Bold" 
                               Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Botones de acción -->
            <Button Text="Iniciar Sesión"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnLoginClicked"
                    Margin="0,20,0,5" />

            <Button Text="Registrarse"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Clicked="OnRegisterClicked" />

            <!-- Footer -->
            <Label Text="Calidad, elegancia y detalle en cada puntada."
                   Style="{StaticResource CaptionStyle}"
                   HorizontalTextAlignment="Center"
                   Margin="10,20,10,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
