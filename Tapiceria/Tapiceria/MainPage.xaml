<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.MainPage"
             BackgroundColor="#121212"
             Title="TapizPro - Tapicería Automotriz">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="CenterAndExpand">

            <!-- Banner superior con sombra -->
            <Frame HasShadow="True" CornerRadius="20" Padding="0">
                <Grid>
                    <Image Source="materiales.jpg"
                           Aspect="AspectFill"
                           HeightRequest="200" />
                    <BoxView BackgroundColor="#00000066" />
                </Grid>
            </Frame>

            <!-- Bienvenida -->
            <Label Text="¡Bienvenido a TapizPro!"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#d9a520"
                   HorizontalOptions="Center" />

            <!-- Descripción -->
            <Label Text="Transformamos el interior de tu vehículo con servicios de tapicería automotriz premium. Desde asientos de cuero hasta detalles personalizados, hacemos que tu auto luzca como nuevo."
                   FontSize="16"
                   TextColor="#cccccc"
                   HorizontalTextAlignment="Center" />

            <!-- Servicios destacados como tarjetas -->
            <VerticalStackLayout Spacing="10">
                <Frame BackgroundColor="#1f1f1f" CornerRadius="12" Padding="10">
                    <Label Text="🔧 Restauración de interiores antiguos" TextColor="#eaeaea" FontSize="14"/>
                </Frame>
                <Frame BackgroundColor="#1f1f1f" CornerRadius="12" Padding="10">
                    <Label Text="🪑 Tapizado en cuero, vinil o tela" TextColor="#eaeaea" FontSize="14"/>
                </Frame>
                <Frame BackgroundColor="#1f1f1f" CornerRadius="12" Padding="10">
                    <Label Text="✨ Personalización de autos de lujo" TextColor="#eaeaea" FontSize="14"/>
                </Frame>
                <Frame BackgroundColor="#1f1f1f" CornerRadius="12" Padding="10">
                    <Label Text="🧼 Limpieza y detallado profesional" TextColor="#eaeaea" FontSize="14"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Botones de acción -->
            <Button Text="Iniciar Sesión"
                    Clicked="OnLoginClicked"
                    BackgroundColor="#d9a520"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold" />

            <Button Text="Registrarse"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="#34c759"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold" />

            <!-- Footer -->
            <Label Text="Calidad, elegancia y detalle en cada puntada."
                   FontSize="12"
                   TextColor="#888"
                   HorizontalTextAlignment="Center"
                   Margin="10,20,10,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
