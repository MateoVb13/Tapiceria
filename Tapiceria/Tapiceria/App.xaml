<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:converters="clr-namespace:Tapiceria.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Tapiceria"
             x:Class="Tapiceria.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:EstadoColorConverter x:Key="EstadoColorConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:PendienteVisibilityConverter x:Key="PendienteVisibilityConverter" />

            <!-- Gradientes usando SOLO la paleta naranja/amarillo -->
            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F17C3A" Offset="0.0" />
                <GradientStop Color="#FFC069" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC069" Offset="0.0" />
                <GradientStop Color="#FFDEBD" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFDEBD" Offset="0.0" />
                <GradientStop Color="#FFC069" Offset="0.6" />
                <GradientStop Color="#F17C3A" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Sombras para elementos -->
            <Shadow x:Key="CardShadow"
                    Brush="Black"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.15" />

            <Shadow x:Key="ButtonShadow"
                    Brush="Black"
                    Offset="0,4"
                    Radius="8"
                    Opacity="0.25" />
        </ResourceDictionary>
    </Application.Resources>
</Application>