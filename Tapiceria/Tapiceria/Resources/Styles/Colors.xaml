<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Colores principales - Paleta Naranja/Amarillo -->
    <Color x:Key="PrimaryColor">#FF9500</Color>
    <Color x:Key="PrimaryDarkColor">#D17900</Color>
    <Color x:Key="PrimaryLightColor">#FFB347</Color>

    <Color x:Key="SecondaryColor">#FFCC00</Color>
    <Color x:Key="SecondaryDarkColor">#E6B800</Color>
    <Color x:Key="SecondaryLightColor">#FFD633</Color>

    <Color x:Key="AccentColor">#FF6600</Color>

    <!-- Colores de fondo -->
    <Color x:Key="BackgroundColor">#F5F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>

    <!-- Colores de texto -->
    <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
    <Color x:Key="TextSecondaryColor">#8E8E93</Color>
    <Color x:Key="TextTertiaryColor">#C7C7CC</Color>

    <!-- Colores de estado -->
    <Color x:Key="SuccessColor">#34C759</Color>
    <Color x:Key="WarningColor">#FF9500</Color>
    <Color x:Key="ErrorColor">#FF3B30</Color>
    <Color x:Key="InfoColor">#007AFF</Color>

    <!-- Colores de borde -->
    <Color x:Key="BorderColor">#E5E5EA</Color>
    <Color x:Key="SeparatorColor">#C6C6C8</Color>

    <!-- Sombras -->
    <Color x:Key="ShadowColor">#40000000</Color>

</ResourceDictionary>