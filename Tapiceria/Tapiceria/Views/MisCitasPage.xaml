<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.MisCitasPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Mis Citas">

    <Grid RowDefinitions="Auto,*" Padding="20">
        <!-- Cabecera -->
        <StackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Label Text="Mis Citas Programadas"
                   Style="{StaticResource TitleStyle}" />

            <Label Text="Aquí puedes ver todas tus citas agendadas"
                   Style="{StaticResource BodyTextStyle}" />
        </StackLayout>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- Indicador de carga -->
            <ActivityIndicator Grid.Row="0" 
                               x:Name="activityIndicator"
                               IsRunning="False"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"
                               HeightRequest="50" 
                               WidthRequest="50" />

            <!-- Lista de citas -->
            <RefreshView Grid.Row="1" 
                         x:Name="refreshView" 
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView x:Name="citasCollectionView"
                                EmptyView="No tienes citas programadas. Toca el botón Agendar Cita para crear una nueva."
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="8">

                                    <!-- Fecha y horario -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Fecha}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{StaticResource TextPrimaryColor}" />

                                    <Frame Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource StatusFrameStyle}"
                                           BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColorConverter}}">
                                        <Label Text="{Binding Estado}"
                                               FontSize="12"
                                               TextColor="White"
                                               FontAttributes="Bold"/>
                                    </Frame>

                                    <!-- Hora -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Horario}"
                                           FontSize="16"
                                           TextColor="{StaticResource TextSecondaryColor}" />

                                    <!-- Servicio y Empleado -->
                                    <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Orientation="Vertical" 
                                                 Spacing="4">

                                        <Label Text="{Binding NombreServicio}"
                                               FontSize="16"
                                               TextColor="{StaticResource PrimaryColor}" />

                                        <Label Text="{Binding NombreEmpleado, StringFormat='Tapicero: {0}'}"
                                               FontSize="14"
                                               TextColor="{StaticResource TextSecondaryColor}"
                                               IsVisible="{Binding NombreEmpleado, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                    </StackLayout>

                                    <!-- Notas (si existen) -->
                                    <Frame Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           IsVisible="{Binding Notas, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                           BackgroundColor="{StaticResource BackgroundColor}"
                                           BorderColor="{StaticResource BorderColor}"
                                           CornerRadius="6"
                                           Padding="10,5"
                                           HasShadow="False">
                                        <Label Text="{Binding Notas}"
                                               FontSize="14"
                                               TextColor="{StaticResource TextSecondaryColor}"
                                               FontAttributes="Italic"/>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Botón flotante para agendar nueva cita -->
            <Button Grid.Row="1"
                    Text="+ Agendar Nueva Cita"
                    Style="{StaticResource PrimaryButtonStyle}"
                    WidthRequest="200"
                    Clicked="OnNuevaCitaClicked"
                    VerticalOptions="End"
                    HorizontalOptions="Center"
                    Margin="0,0,0,20"/>
        </Grid>
    </Grid>
</ContentPage>