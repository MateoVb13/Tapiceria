<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.MisCitasPage"
             Title="Mis Citas">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Mis Citas Programadas"
               FontSize="Large"
               HorizontalOptions="Center" />

        <ActivityIndicator x:Name="activityIndicator"
                           IsRunning="False"
                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                           HorizontalOptions="Center" />

        <CollectionView x:Name="citasCollectionView">
            <CollectionView.EmptyView>
                <ContentView>
                    <Label Text="No tienes citas programadas."
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </ContentView>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" CornerRadius="5">
                        <StackLayout Orientation="Vertical" Spacing="5">
                            <Label Text="{Binding Fecha}" FontAttributes="Bold" FontSize="Medium"/>
                            <Label Text="{Binding Horario}" FontAttributes="Bold" FontSize="Medium"/>
                            <Label Text="{Binding NombreServicio}" FontSize="Small" TextColor="Gray"/>
                            <Label Text="{Binding NombreEmpleado}" FontSize="Small" TextColor="Gray"/>
                            <Label Text="{Binding Estado}" FontSize="Small" TextColor="Blue"/>
                            <Label Text="{Binding Notas}" FontSize="Small" FontAttributes="Italic" IsVisible="{Binding Notas, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>