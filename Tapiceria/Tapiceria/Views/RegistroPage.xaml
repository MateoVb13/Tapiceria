<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.RegistroPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Registro de Usuario">

    <Grid>


        <!-- Contenido principal -->
        <ScrollView Margin="0,60,0,0">
            <StackLayout Padding="30" Spacing="20" VerticalOptions="CenterAndExpand">

                <!-- Título -->
                <Label Text="Crear Cuenta"
                       Style="{StaticResource TitleStyle}" />

                <!-- Usuario -->
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry x:Name="entryNombreUsuario"
                           Placeholder="Nombre de Usuario" />
                </Frame>

                <!-- Correo -->
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry x:Name="entryCorreo"
                           Placeholder="Correo electrónico"
                           Keyboard="Email" />
                </Frame>

                <!-- Contraseña -->
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry x:Name="entryContrasena"
                           Placeholder="Contraseña"
                           IsPassword="True" />
                </Frame>

                <!-- Confirmar contraseña -->
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry x:Name="entryConfirmarContrasena"
                           Placeholder="Confirmar contraseña"
                           IsPassword="True" />
                </Frame>


                <!-- Indicador de actividad -->
                <ActivityIndicator x:Name="loadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   HorizontalOptions="Center" />

                <!-- Botón registrar -->
                <Button Text="Registrar"
                        BackgroundColor="{StaticResource WarningColor}" 
                        Clicked="OnRegistrarClicked"
                        Margin="0,15" />

                <!-- Opción de login -->
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                    <Label Text="¿Ya tienes cuenta?" 
                           TextColor="{StaticResource TextSecondaryColor}" 
                           VerticalOptions="Center"/>

                    <Label Text="Iniciar Sesión" 
                           TextColor="{StaticResource PrimaryColor}" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToLogin" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>