<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.LoginPage"
             BackgroundColor="#121212"
             Title="Iniciar Sesión">

    <ScrollView>
        <StackLayout Padding="30" Spacing="20" VerticalOptions="CenterAndExpand">

            <!-- Título -->
            <Label Text="Inicio de Sesión"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#d9a520"
                   HorizontalOptions="Center" />

            <!-- Campo para correo -->
            <Frame BackgroundColor="#1f1f1f" CornerRadius="10" Padding="10" HasShadow="False">
                <Entry x:Name="entryCorreo"
                       Placeholder="Correo electrónico"
                       Keyboard="Email"
                       TextColor="White"
                       PlaceholderColor="#999"
                       BackgroundColor="Transparent" />
            </Frame>

            <!-- Campo para contraseña -->
            <Frame BackgroundColor="#1f1f1f" CornerRadius="10" Padding="10" HasShadow="False">
                <Entry x:Name="entryContrasena"
                       Placeholder="Contraseña"
                       IsPassword="True"
                       TextColor="White"
                       PlaceholderColor="#999"
                       BackgroundColor="Transparent" />
            </Frame>

            <!-- Botón para iniciar sesión -->
            <Button Text="Iniciar Sesión"
                    Clicked="OnLoginClicked"
                    BackgroundColor="#d9a520"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold" />

        </StackLayout>
    </ScrollView>
</ContentPage>
