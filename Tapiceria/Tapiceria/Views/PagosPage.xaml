<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.PagosPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Pagos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Cabecera -->
            <StackLayout Orientation="Vertical" Spacing="8">
                <Label Text="Gestión de Pagos"
                       Style="{StaticResource TitleStyle}" />

                <Label Text="Administra los pagos de tus servicios completados"
                       Style="{StaticResource BodyTextStyle}" />
            </StackLayout>

            <!-- Sección de Pagos Pendientes -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Pagos Pendientes"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource WarningColor}"
                           HorizontalOptions="Center" />

                    <ActivityIndicator x:Name="activityIndicatorPendientes"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <Label x:Name="lblSinPagosPendientes"
                           Text="No tienes pagos pendientes."
                           TextColor="{StaticResource TextSecondaryColor}"
                           HorizontalOptions="Center"
                           IsVisible="False" />

                    <CollectionView x:Name="pagosPendientesCollection"
                                    SelectionMode="None"
                                    HeightRequest="200">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Style="{StaticResource CardStyle}"
                                       BackgroundColor="{StaticResource SurfaceColor}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                          ColumnDefinitions="*,Auto"
                                          RowSpacing="8">

                                        <!-- Servicio -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding NombreServicio}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimaryColor}"
                                               FontSize="16" />

                                        <!-- Monto -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding MontoString}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SuccessColor}"
                                               FontSize="18" />

                                        <!-- Fecha -->
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding FechaCitaString, StringFormat='Fecha del servicio: {0}'}"
                                               TextColor="{StaticResource TextSecondaryColor}"
                                               FontSize="14" />

                                        <!-- Estado -->
                                        <Frame Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource StatusFrameStyle}"
                                               BackgroundColor="{StaticResource WarningColor}">
                                            <Label Text="{Binding Estado}"
                                                   FontSize="12"
                                                   TextColor="White"
                                                   FontAttributes="Bold"/>
                                        </Frame>

                                        <!-- Botón Pagar -->
                                        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                Text="Pagar Ahora"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Clicked="OnPagarClicked"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Sección de Historial de Pagos -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Historial de Pagos"
                           Style="{StaticResource SubtitleStyle}"
                           TextColor="{StaticResource PrimaryColor}"
                           HorizontalOptions="Center" />

                    <ActivityIndicator x:Name="activityIndicatorHistorial"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <Label x:Name="lblSinHistorial"
                           Text="No tienes pagos registrados."
                           TextColor="{StaticResource TextSecondaryColor}"
                           HorizontalOptions="Center"
                           IsVisible="False" />

                    <CollectionView x:Name="historialPagosCollection"
                                    SelectionMode="None"
                                    HeightRequest="300">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Style="{StaticResource CardStyle}"
                                       BackgroundColor="{StaticResource SurfaceColor}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" 
                                          ColumnDefinitions="*,Auto"
                                          RowSpacing="5">

                                        <!-- Monto -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ValorPago, StringFormat='${0:N2}'}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SuccessColor}"
                                               FontSize="18" />

                                        <!-- Tipo de Pago -->
                                        <Frame Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource StatusFrameStyle}"
                                               BackgroundColor="{StaticResource InfoColor}">
                                            <Label Text="{Binding TipoPago}"
                                                   FontSize="12"
                                                   TextColor="White"
                                                   FontAttributes="Bold"/>
                                        </Frame>

                                        <!-- Fecha -->
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding FechaCita, StringFormat='Pagado el: {0:dd/MM/yyyy}'}"
                                               TextColor="{StaticResource TextSecondaryColor}"
                                               FontSize="14" />

                                        <!-- Estado -->
                                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding EstadoCita, StringFormat='Estado del servicio: {0}'}"
                                               TextColor="{StaticResource TextSecondaryColor}"
                                               FontSize="14" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>