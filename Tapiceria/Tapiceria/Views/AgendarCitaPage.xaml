<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.AgendarCitaPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Agendar Cita">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Cabecera -->
            <StackLayout Orientation="Vertical" Spacing="8">
                <Label Text="Agendar Nueva Cita"
                       Style="{StaticResource TitleStyle}" />

                <Label Text="Selecciona el servicio, fecha y horario para tu cita"
                       Style="{StaticResource BodyTextStyle}" />
            </StackLayout>

            <!-- Paso 1: Selección de servicio -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Selecciona el Servicio"
                           Style="{StaticResource SubtitleStyle}" />

                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <Picker x:Name="servicePicker"
                                Title="-- Selecciona un servicio --"
                                ItemDisplayBinding="{Binding Descripcion}"
                                SelectedIndexChanged="OnServiceSelected" />
                    </Frame>

                    <Label Text="Duración estimada:" 
                           TextColor="{StaticResource TextSecondaryColor}" 
                           FontSize="14" />
                    <Label x:Name="lblDuracion" 
                           Text="--" 
                           TextColor="{StaticResource TextPrimaryColor}" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Label Text="Precio:" 
                           TextColor="{StaticResource TextSecondaryColor}" 
                           FontSize="14" />
                    <Label x:Name="lblPrecio" 
                           Text="--" 
                           TextColor="{StaticResource SuccessColor}" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <!-- Paso 2: Selección de fecha -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2. Selecciona la Fecha"
                           Style="{StaticResource SubtitleStyle}" />

                    <DatePicker x:Name="datePicker"
                                MinimumDate="{Binding MinDate}"
                                Format="D"
                                DateSelected="OnDateSelected" />

                    <Label Text="Solo se muestran fechas disponibles para los próximos 30 días."
                           Style="{StaticResource CaptionStyle}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Paso 3: Selección de horario -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="3. Selecciona el Horario"
                           Style="{StaticResource SubtitleStyle}" />

                    <ActivityIndicator x:Name="activityIndicator"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <Label x:Name="lblNoHorarios" 
                           Text="No hay horarios disponibles para la fecha seleccionada."
                           TextColor="{StaticResource ErrorColor}"
                           HorizontalOptions="Center"
                           IsVisible="False" />

                    <!-- Grid de horarios disponibles -->
                    <Grid x:Name="gridHorarios" 
                          ColumnDefinitions="*,*" 
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                        <!-- Los horarios se agregarán dinámicamente aquí -->
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Paso 4: Detalles de la cita seleccionada -->
            <Frame x:Name="frameCitaSeleccionada" 
                   Style="{StaticResource CardStyle}" 
                   IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Detalles de la Cita"
                           Style="{StaticResource SubtitleStyle}" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Servicio:" TextColor="{StaticResource TextSecondaryColor}" />
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lblServicioSeleccionado" TextColor="{StaticResource TextPrimaryColor}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Fecha:" TextColor="{StaticResource TextSecondaryColor}" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblFechaSeleccionada" TextColor="{StaticResource TextPrimaryColor}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Hora:" TextColor="{StaticResource TextSecondaryColor}" />
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lblHoraSeleccionada" TextColor="{StaticResource TextPrimaryColor}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Tapicero:" TextColor="{StaticResource TextSecondaryColor}" />
                        <Label Grid.Row="3" Grid.Column="1" x:Name="lblEmpleadoSeleccionado" TextColor="{StaticResource TextPrimaryColor}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Paso 5: Notas adicionales -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="5. Notas Adicionales (Opcional)"
                           Style="{StaticResource SubtitleStyle}" />

                    <Frame Style="{StaticResource EntryFrameStyle}" HeightRequest="100">
                        <Editor x:Name="notasEditor"
                                Placeholder="Añade cualquier información adicional para tu cita..."
                                AutoSize="TextChanges" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Botón de confirmación -->
            <Button x:Name="btnConfirmar"
                    Text="Confirmar Cita"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False"
                    Clicked="OnConfirmarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>