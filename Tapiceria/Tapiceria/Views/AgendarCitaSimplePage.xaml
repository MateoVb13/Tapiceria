<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.AgendarCitaSimplePage"
             Title="Agendar Cita">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Agendar Nueva Cita"
               FontSize="Large"
               HorizontalOptions="Center" />

        <Label Text="Selecciona el Servicio:" FontSize="Medium"/>
        <Picker x:Name="servicePicker"
                Title="-- Selecciona un servicio --"
                ItemDisplayBinding="{Binding NombreServicio}"
                SelectedIndexChanged="OnServiceSelected"/>

        <Label Text="Precio:" FontSize="Medium"/>
        <Label x:Name="lblPrecioServicio"
               Text="--"
               FontSize="Large"
               FontAttributes="Bold"
               TextColor="Green"/>

        <Label Text="Selecciona la Fecha:" FontSize="Medium" x:Name="lblSeleccionaFecha"/>
        <DatePicker x:Name="datePicker"
                    Format="D"
                    DateSelected="OnDateSelected"/>

        <Label Text="Horarios Disponibles:" FontSize="Medium" x:Name="lblHorariosDisponibles"/>
        <ActivityIndicator x:Name="activityIndicator"
                           IsRunning="False"
                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                           HorizontalOptions="Center" />

        <CollectionView x:Name="horariosDisponiblesCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="OnHorarioSelected">
            <CollectionView.EmptyView>
                <ContentView>
                    <Label Text="No hay horarios disponibles para la fecha seleccionada."
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </ContentView>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" CornerRadius="5">
                        <Label Text="{Binding ., StringFormat='{0:hh\\:mm tt}'}" FontSize="Medium"/>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="btnConfirmarCita"
                 Text="Confirmar Cita"
                 Clicked="OnConfirmarCitaClicked"
                 IsEnabled="False"
                 />

    </VerticalStackLayout>
</ContentPage>