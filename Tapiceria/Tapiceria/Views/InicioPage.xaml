<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.InicioPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- Encabezado -->
            <Label Text="¡Hola, bienvenido a TapizPro!"
                   Style="{StaticResource TitleStyle}" />

            <Label Text="¿Qué servicio deseas hoy?"
                   Style="{StaticResource BodyTextStyle}" />

            <!-- Servicios destacados con estilo -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Nuestros Servicios"
                           Style="{StaticResource SubtitleStyle}" />

                    <Label Text="🪑 Tapizado profesional de asientos"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondaryColor}" />
                    <Label Text="🧼 Detallado interior completo"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondaryColor}" />
                    <Label Text="🔧 Restauración de volantes y paneles"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondaryColor}" />
                    <Label Text="🎨 Personalización de interiores"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Botones de acción -->
            <Button Text="Agendar Cita"
                     BackgroundColor="{StaticResource WarningColor}"
                     TextColor="White"
                     CornerRadius="12"
                     HeightRequest="50"
                     FontAttributes="Bold" 
                    Clicked="OnAgendarCitaClicked"/>

            <Button Text="Ver Mis Citas"
                    BackgroundColor="{StaticResource WarningColor}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold" 
                    Clicked="OnVerMisCitasClicked"/>

            <Button Text="Mi Perfil"
                    BackgroundColor="{StaticResource WarningColor}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold" 
                    Clicked="OnVerPerfilClicked"
                    Margin="0,10,0,0"/>

            <Button Text="Mis Pagos"
                    BackgroundColor="{StaticResource WarningColor}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold" 
                    Clicked="OnPagosClicked"
                    Margin="0,10,0,0"/>

            <Button Text="Cerrar Sesión"
                    BackgroundColor="{StaticResource ErrorColor}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Clicked="OnCerrarSesionClicked" />

            <!-- Footer -->
            <Label Text="Calidad, elegancia y detalle en cada puntada."
                   Style="{StaticResource CaptionStyle}"
                   HorizontalTextAlignment="Center"
                   Margin="10,20,10,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>