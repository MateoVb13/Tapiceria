<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tapiceria.Views.PerfilPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Mi Perfil">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Sección de información personal -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Información Personal"
                           Style="{StaticResource SubtitleStyle}"
                           TextColor="{StaticResource PrimaryColor}"
                           HorizontalOptions="Center" />

                    <!-- Nombre de Usuario (No editable) -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nombre de Usuario" 
                               TextColor="{StaticResource TextSecondaryColor}"
                               FontSize="14" />
                        <Label x:Name="lblNombreUsuario"
                               TextColor="{StaticResource TextPrimaryColor}"
                               FontSize="18"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- Correo Electrónico (No editable) -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Correo Electrónico" 
                               TextColor="{StaticResource TextSecondaryColor}"
                               FontSize="14" />
                        <Label x:Name="lblCorreo"
                               TextColor="{StaticResource TextPrimaryColor}"
                               FontSize="18"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- Teléfono de Contacto (Editable) -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Teléfono de Contacto" 
                               TextColor="{StaticResource TextSecondaryColor}"
                               FontSize="14" />
                        <Frame Style="{StaticResource EntryFrameStyle}">
                            <Entry x:Name="entryContacto"
                                   Placeholder="Ej: 315-123-4567"
                                   Keyboard="Telephone" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Dirección (Editable) -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Dirección" 
                               TextColor="{StaticResource TextSecondaryColor}"
                               FontSize="14" />
                        <Frame Style="{StaticResource EntryFrameStyle}">
                            <Entry x:Name="entryDireccion"
                                   Placeholder="Ej: Calle 10 #23-45, Sincelejo" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Botón Guardar -->
                    <Button Text="Guardar Cambios"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,10,0,0"
                            Clicked="OnGuardarClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- Sección de historial de citas -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Historial de Servicios"
                           Style="{StaticResource SubtitleStyle}"
                           TextColor="{StaticResource PrimaryColor}"
                           HorizontalOptions="Center" />

                    <ActivityIndicator x:Name="activityIndicator"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <Label x:Name="lblSinHistorial"
                           Text="No has completado ningún servicio aún."
                           TextColor="{StaticResource TextSecondaryColor}"
                           HorizontalOptions="Center"
                           IsVisible="False" />

                    <CollectionView x:Name="citasCompletadasCollection"
                                    SelectionMode="None"
                                    EmptyView="No tienes servicios completados."
                                    HeightRequest="300">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Style="{StaticResource CardStyle}"
                                       BackgroundColor="{StaticResource SurfaceColor}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" 
                                          ColumnDefinitions="*,Auto"
                                          RowSpacing="5">

                                        <!-- Servicio -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding NombreServicio}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource SuccessColor}"
                                               FontSize="16" />

                                        <!-- Estado -->
                                        <Frame Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource StatusFrameStyle}"
                                               BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColorConverter}}">
                                            <Label Text="{Binding Estado}"
                                                   FontSize="12"
                                                   TextColor="White"
                                                   FontAttributes="Bold"/>
                                        </Frame>

                                        <!-- Fecha -->
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Fecha}"
                                               TextColor="{StaticResource TextSecondaryColor}"
                                               FontSize="14" />

                                        <!-- Empleado -->
                                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding NombreEmpleado, StringFormat='Tapicero: {0}'}"
                                               TextColor="{StaticResource TextSecondaryColor}"
                                               FontSize="14"
                                               IsVisible="{Binding NombreEmpleado, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>